# Local development only. Copy to .env (gitignored) and fill in.
# In production these are set as Railway service variables, never as a file.
#
# Load into your shell before running `npm run auth`:
#   set -a; source .env; set +a

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Minted by `npm run auth`, which prints it to the terminal.
# Required by the server; leave empty when running `npm run auth` for the first time.
SPOTIFY_REFRESH_TOKEN=

# Gate for the remote endpoint, which is mounted at POST /mcp/<this value>.
# Generate with: openssl rand -hex 32
# Hex specifically: the value goes in a URL path segment, and base64's / and +
# would need escaping.
MCP_SHARED_SECRET=

# Optional. Only used by `npm run auth`; must be a loopback address and must
# match the redirect URI registered in the Spotify app.
# Defaults to http://127.0.0.1:8888/callback
# SPOTIFY_REDIRECT_URI=

# PORT is injected by Railway. Locally it defaults to 8888.
# PORT=8888
